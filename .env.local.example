# Copy this file to .env.local and fill in your Supabase credentials.
# Get these from: https://app.supabase.com → Project Settings → API
#
# Auth (Google + magic link) needs NEXT_PUBLIC_SUPABASE_URL + ANON_KEY on Vercel too.
# Fuel Tracker API + counters need SUPABASE_SERVICE_ROLE_KEY (server only).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Anon / publishable key — safe for the browser (RLS-enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_anon_key_here
# Service role — server-only (Route Handlers). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_service_role_key_here

# Contact form (Resend) — server-only. Domain must be verified in Resend.
# From stays hello@… publicly; To is your real inbox (forward optional).
RESEND_API_KEY=re_xxxxxxxx
CONTACT_FROM_EMAIL=NexusDigitalLabs <hello@nexusdigitallabs.dev>
CONTACT_TO_EMAIL=you@example.com

# Odova (mobile app) Pro entitlement webhook — server-only. Set this to a
# random secret, then set the *same* value as the "Authorization header value"
# for this endpoint's webhook in the RevenueCat dashboard (Project →
# Integrations → Webhooks). See src/app/api/revenuecat-webhook/route.ts.
REVENUECAT_WEBHOOK_SECRET=

# AdSense publisher ID (ca-pub-XXXXXXXXXXXXXXXX) — public, safe for the
# browser. Leave unset until approved; AdSenseScript.tsx no-ops without it.
# See src/lib/consent.ts for the consent gate this respects.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# AdSense ad-unit slot IDs (per placement, created in the AdSense dashboard
# once approved: Ads → By ad unit → Display ads). Each is public, safe for
# the browser. Leave unset to keep that placement a no-op — see AdSlot.tsx.
# One slot ID per PAGE TYPE, reused across every page of that type (not one
# per individual URL) — standard AdSense practice, and simpler to manage.
NEXT_PUBLIC_ADSENSE_SLOT_ACADEMY_LOBBY=
NEXT_PUBLIC_ADSENSE_SLOT_ACADEMY_LESSON=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_TOOLS=
NEXT_PUBLIC_ADSENSE_SLOT_GAMES_INDEX=
NEXT_PUBLIC_ADSENSE_SLOT_GAMES=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLES_INDEX=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLES=
